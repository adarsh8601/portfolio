{
  "name": "adarsh-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "vite",
    "dev:api": "node --watch-path=server --watch-path=shared --watch-path=src/data server/node.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/node.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test tests/api.test.js tests/vercel.test.js",
    "check": "npm run lint && npm test && npm run build",
    "upload-resume": "node scripts/upload-resume.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.1.0",
    "@fontsource/dm-sans": "^5.1.0",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "nodemailer": "^6.9.16"
  },
  "engines": {
    "node": ">=20.12"
  }
}
