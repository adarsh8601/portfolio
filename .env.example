# Copy to .env (never commit .env). Server-side only — none of these reach the browser.

NODE_ENV=development            # production refuses to start with missing/unsafe settings
PORT=8787
PUBLIC_SITE_URL=http://localhost:5173   # used to build links in emails, e.g. https://adarshgiri.dev
# ALLOWED_ORIGINS=https://adarshgiri.dev  # only if the site and API are on different origins
# TRUST_PROXY=true                      # behind a reverse proxy / PaaS, to rate-limit by real client IP

# --- Secrets -------------------------------------------------------------
TOKEN_SECRET=                  # >= 32 random chars:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_PASSCODE=                # >= 12 chars; required on the approval page in addition to the signed link

# --- Notifications ---------------------------------------------------------
NOTIFY_EMAIL=                  # your private inbox: contact messages + resume requests go here
MAIL_FROM=                     # e.g. "Adarsh Giri <portfolio@yourdomain.com>" (Resend: a verified domain)
MAIL_PROVIDER=console         # console (dev only, prints to log) | smtp | resend

# smtp — e.g. Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true + an App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# resend — https://resend.com (to email visitors you must verify a sending domain)
RESEND_API_KEY=

# --- Resume PDF workflow -----------------------------------------------------
RESUME_PDF_PATH=server/private/resume.pdf   # private: NOT in /public, never served statically
DATA_DIR=data                               # where resume-requests.json is stored (persistent disk)
REVIEW_LINK_TTL_HOURS=168
DOWNLOAD_LINK_TTL_HOURS=48                  # keep in sync with resume.pdf.linkValidHours in src/data/content.js
MAX_DOWNLOADS=3
RETENTION_DAYS=90

# --- Vercel / serverless only -------------------------------------------------
# Upstash Redis (free) stores resume requests + the private PDF (Vercel has no disk).
# Get both from https://console.upstash.com → your database → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
